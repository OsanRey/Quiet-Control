{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satelite Research",
  "version": "../package.json",
  "identifier": "org.personalnet.satelite.research",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Satelite",
        "width": 1200,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/darwin-arm64/sing-box",
      "resources/bin/darwin-arm64/version.txt",
      "resources/bin/darwin-arm64/xray",
      "resources/bin/darwin-arm64/xray-version.txt",
      "resources/bin/darwin-arm64/geosite.dat",
      "resources/bin/darwin-arm64/geoip.dat",
      "resources/bin/darwin-arm64/mihomo",
      "resources/bin/darwin-arm64/mihomo-version.txt",
      "resources/bin/darwin-arm64/mihomo-geodata/Country.mmdb",
      "resources/bin/darwin-arm64/mihomo-geodata/GeoSite.dat",
      "resources/rule-sets",
      "resources/dns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "satelite-research"
        ]
      }
    }
  }
}
